# 复制为 .env 后按需修改（.env 不会被提交）

# 前端端口
WEB_PORT=8001
# 后端端口
PORT=8080

# 访问密码：留空表示不启用登录（仅限本机/内网可信环境）
WEB_PASSWORD=

# 会话密钥：留空则首次启动自动生成
SESSION_SECRET=

# SMTP 也可以在网页「设置」里配置，这里的值优先级更高
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=497232807@qq.com
SMTP_PASS=zchwrimdiemrcajd

# ---------- 以下两项只在 Docker（docker compose）下生效 ----------
# 容器内的服务端口，同时也是默认的宿主机访问端口（容器内外一起变）
APP_PORT=3001

# 仅当你想让「浏览器访问的端口」和「容器内端口」不同时才填
# WEB_PUBLISH_PORT=8080