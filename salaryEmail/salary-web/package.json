{
  "name": "salary-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --mode development --open",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "gen:demo": "tsx scripts/gen-demo-data.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
